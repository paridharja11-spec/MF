
fun main() {
    var menu: Int
    do {
        println("\n===== TUGAS LOOP KOTLIN - MF RPL D =====")
        println("1. Soal 1 - Deret Genap 2-50 (for)")
        println("2. Soal 2 - Hitung Mundur 10-1 (while)")
        println("3. Soal 3 - Kelipatan skip 4 & break 25")
        println("4. Soal 4 - Validasi PIN ATM (do-while FIX)")
        println("5. Soal 5 - Segitiga Bintang (nested loop)")
        println("6. Soal 6 - Tabel Perkalian (nested loop)")
        println("7. Soal 7 - Menu Kasir Interaktif")
        println("8. Keluar")
        print("Pilih menu: ")
        menu = readLine()?.toIntOrNull() ?: 0

        when(menu) {
            1 -> {
                // Soal 1
                for (i in 2..50 step 2) print("$i ")
                println()
            }
            2 -> {
                // Soal 2
                var a = 10
                while(a >= 1) { println(a); a-- }
                println("Mulai!")
            }
            3 -> {
                // Soal 3
                for (i in 1..30) {
                    if (i == 25) break
                    if (i % 4 == 0) continue
                    println(i)
                }
            }
            4 -> {
                // Soal 4 - VERSI FIX ANTI ERROR
                val pinBenar = "1234"
                do {
                    print("Masukkan PIN: ")
                    val input = readln()
                    if (input == pinBenar) {
                        println("Login Berhasil!")
                        break
                    } else {
                        println("PIN Salah, silakan coba lagi!")
                    }
                } while (true)
            }
            5 -> {
                // Soal 5
                for (i in 1..5) {
                    for (j in 1..i) print("*")
                    println()
                }
            }
            6 -> {
                // Soal 6
                for (i in 1..5) {
                    for (j in 1..5) print("$i x $j=${i*j}\t")
                    println()
                }
            }
            7 -> {
                // Soal 7
                var pil: Int
                do {
                    println("\n-- Menu Kasir --")
                    println("1. Luas Persegi Panjang")
                    println("2. Luas Lingkaran")
                    println("3. Kembali")
                    print("Pilih: ")
                    pil = readLine()?.toIntOrNull() ?: 0
                    when(pil) {
                        1 -> {
                            print("Panjang: "); val p = readLine()!!.toDouble()
                            print("Lebar: "); val l = readLine()!!.toDouble()
                            println("Luas = ${p*l}")
                        }
                        2 -> {
                            print("Jari-jari: "); val r = readLine()!!.toDouble()
                            println("Luas = ${3.14 * r * r}")
                        }
                        3 -> println("Kembali ke menu utama")
                        else -> println("Pilihan tidak valid")
                    }
                } while(pil != 3)
            }
            8 -> println("Terima kasih!")
            else -> println("Pilihan tidak valid")
        }
    } while(menu != 8)
}
