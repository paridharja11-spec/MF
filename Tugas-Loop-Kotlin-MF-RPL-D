fun main() {
    // Soal 1: Deret Angka Genap
    for (i in 2..50 step 2) {
        print("$i ")
    }
}

fun main() {
    // Soal 2: Menggunakan while
    var angka = 10
    while (angka >= 1) {
        println(angka)
        angka--
    }
    println("Mulai!")
}

fun main() {
    // Soal 3: lewati kelipatan 4, berhenti di 25
    for (i in 1..30) {
        if (i == 25) {
            break // hentikan perulangan total
        }
        if (i % 4 == 0) {
            continue // lewati angka ini
        }
        println(i)
    }
}

fun main() {
    val pinBenar = "1234"
    do {
        print("Masukkan PIN: ")
        val inputPin = readln()
        if (inputPin == pinBenar) {
            println("Login Berhasil!")
            break
        } else {
            println("PIN Salah, silakan coba lagi!")
        }
    } while (true)
}

fun main() {
    // Soal 5: Nested loop untuk pola
    for (i in 1..5) { // baris
        for (j in 1..i) { // kolom
            print("*")
        }
        println()
    }
}

fun main() {
    // Soal 6: Tabel perkalian
    for (i in 1..5) {
        for (j in 1..5) {
            print("${i} x ${j} = ${i * j}\t")
        }
        println() // ganti baris
    }
}
fun main() {
    var pilihan: Int

    do {
        println("\n=== MENU KASIR SEDERHANA ===")
        println("1. Hitung Luas Persegi Panjang")
        println("2. Hitung Luas Lingkaran")
        println("3. Keluar")
        print("Pilih menu (1-3): ")

        pilihan = readLine()?.toIntOrNull() ?: 0

        when (pilihan) {
            1 -> {
                print("Masukkan panjang: ")
                val p = readLine()!!.toDouble()
                print("Masukkan lebar: ")
                val l = readLine()!!.toDouble()
                println("Hasil: Luas Persegi Panjang = ${p * l}")
            }
            2 -> {
                print("Masukkan jari-jari: ")
                val r = readLine()!!.toDouble()
                val luas = 3.14 * r * r
                println("Hasil: Luas Lingkaran = $luas")
            }
            3 -> {
                println("Terima kasih! Program selesai.")
            }
            else -> {
                println("Pilihan tidak valid")
            }
        }
    } while (pilihan != 3)
}
